# Context is the SDK repository root, not model-lab/.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /sdk
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
COPY model-lab/src ./lab-src
RUN useradd --system --uid 10001 --no-create-home modelrunner
USER 10001
ENV PATH="/sdk/.venv/bin:$PATH" PYTHONPATH=/sdk/src:/sdk/lab-src
ENTRYPOINT ["python", "-m", "action_security_lab.dataset"]
