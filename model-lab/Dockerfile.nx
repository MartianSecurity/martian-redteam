# Reuses the already pinned CUDA lab dependencies; this is a research image.
ARG LAB_IMAGE=martian-model-lab:upgrade-20261017-cuda-v5
FROM ${LAB_IMAGE}
COPY src /lab/src
COPY --from=inputs --chown=10001:10001 . /nx-inputs
COPY --from=dataset --chown=10001:10001 . /nx-dataset
ENTRYPOINT ["python", "-m", "action_security_lab.nx_experiment"]
