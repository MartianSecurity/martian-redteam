FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
WORKDIR /lab
COPY requirements-injection-reference.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements-injection-reference.txt
COPY --from=reference --chmod=0444 fp32.onnx int8-int4.onnx tokenizer.json /model/
COPY --from=reference --chmod=0444 LICENSE README.md manifest.json quantization_manifest.json /usr/share/licenses/wolf-reference/
RUN chmod 0555 /model /usr/share/licenses/wolf-reference
COPY injection_reference.py wolf_reference.py injection-reference-corpus.jsonl ./
USER 65532:65532
ENTRYPOINT ["python", "wolf_reference.py"]
