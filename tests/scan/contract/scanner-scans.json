  "info": {
    "description": "The customer /v1/scanner routes of the hosted backend (not the worker's). Generated from the backend's routes; do not edit by hand.",
    "title": "Martian Scanner scan API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/scanner/scans": {
      "get": {
        "operationId": "list_scans_v1_scanner_scans_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "queued",
                    "running",
                    "completed",
                    "failed"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "in": "query",
            "name": "subject_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Subject Id"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "skill",
                    "mcp_server",
                    "plugin",
                    "subagent",
                    "harness_config",
                    "agent_code",
                    "repository",
                    "registry_entry"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "content_digest",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Content Digest"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Scans",
        "tags": [
          "scanner"
        ]
      },
      "post": {
        "operationId": "upload_v1_scanner_scans_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "archive": {
                  "contentType": "application/zip"
                },
                "manifest": {
                  "contentType": "application/json"
                }
              },
              "schema": {
                "properties": {
                  "archive": {
                    "description": "A ZIP file; the second part",
                    "format": "binary",
                    "type": "string"
                  },
                  "manifest": {
                    "additionalProperties": false,
                    "description": "JSON, at most 16 KiB; the first part",
                    "properties": {
                      "options": {
                        "additionalProperties": false,
                        "properties": {
                          "model_analysis": {
                            "default": true,
                            "title": "Model Analysis",
                            "type": "boolean"
                          }
                        },
                        "title": "ScanOptions",
                        "type": "object"
                      },
                      "source": {
                        "default": "api",
                        "enum": [
                          "console",
                          "cli",
                          "ci",
                          "api"
                        ],
                        "title": "Source",
                        "type": "string"
                      },
                      "subject": {
                        "additionalProperties": false,
                        "properties": {
                          "agent_id": {
                            "anyOf": [
                              {
                                "format": "uuid",
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "title": "Agent Id"
                          },
                          "kind": {
                            "enum": [
                              "skill",
                              "mcp_server",
                              "plugin",
                              "subagent",
                              "harness_config",
                              "agent_code",
                              "repository",
                              "registry_entry"
                            ],
                            "title": "Kind",
                            "type": "string"
                          },
                          "name": {
                            "maxLength": 200,
                            "minLength": 1,
                            "title": "Name",
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "name"
                        ],
                        "title": "SubjectIn",
                        "type": "object"
                      }
                    },
                    "required": [
                      "subject"
                    ],
                    "title": "UploadManifest",
                    "type": "object"
                  }
                },
                "required": [
                  "manifest",
                  "archive"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Upload",
        "tags": [
          "scanner"
        ]
      }
    },
    "/v1/scanner/scans/{scan_id}": {
      "get": {
        "operationId": "get_scan_v1_scanner_scans__scan_id__get",
        "parameters": [
          {
            "in": "path",
